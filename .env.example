# App
APP_NAME=Herbolario Online
APP_ENV=development
DEBUG=True

# Database - Local (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./herbolario.db

# Database - Produccion (Render) - usar solo en Render
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
